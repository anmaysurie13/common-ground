# Copy to .env.local and fill in. Never commit real values.
# Everything is optional: with no Supabase vars the app stores data in .data/db.json,
# and with no Gemini key the AI helpers are hidden and rule-based summaries are used.

# --- Supabase (database) ---
# Project URL (safe to be public).
NEXT_PUBLIC_SUPABASE_URL=
# Not used by the current build: the browser never talks to Supabase directly.
# Reserved for adding Supabase Auth later.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used by server actions to read/write. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (optional AI helpers) ---
# SERVER ONLY. Used to turn free-text preferences into a draft and to summarise trade-offs.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-2.5-flash
